robincar_contrast(rc_glm, contrast_h = "log_ratio", contrast_dh = "log_ratio")
robincar_contrast(rc_glm, contrast_dh = function(est){
base <- est[1] / (1-est[1])
cont <- log(est[-1] / (1-est[-1]) / base)
return(cont)
})
robincar_contrast(rc_glm, contrast_h = "log_ratio", contrast_dh = function(est){
base <- est[1] / (1-est[1])
cont <- log(est[-1] / (1-est[-1]) / base)
return(cont)
})
robincar_contrast(rc_glm, contrast_h = function(est){
base <- est[1] / (1-est[1])
cont <- log(est[-1] / (1-est[-1]) / base)
return(cont)
})
log_ratio <- function(est){
base <- est[1] / (1-est[1])
cont <- log(est[-1] / (1-est[-1]) / base)
return(cont)
}
jacobian.LOGRATIO <- function(settings, est){
col1 <- -1 / est[1]
mat1 <- diag(1/est[-1], length(est)-1)
jacob <- cbind(col1, mat1)
return(jacob)
}
robincar_contrast(rc_glm, contrast_h = log_ratio, contrast_dh = jacobian.LOGRATIO)
res_tmp<-RobinCar::robincar_contrast(rc_glm, contrast_h = log_ratio, contrast_dh = jacobian.LOGRATIO)
