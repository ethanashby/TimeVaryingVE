for(k in 1:num_outcomes){
if(k==j){
w[,k]<-1
}else{
# Return
bw = (4/(num_outcomes-1+2))^(1/(num_outcomes - 1 + 4)) * stats::sd(imputed_datasets[[(iter+1)]][[T.names[k]]][rs_indx]) * (nrow(risk_set))^(-1/(num_outcomes - 1 + 4))
